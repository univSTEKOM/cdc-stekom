# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Backend API handover notes — contain live X-API-Key / X-Admin-Key values.
# Keep local only; never commit.
API-STATUS*.txt
API-STATUS*.md

# Claude Code local settings — per-machine permissions and paths.
.claude/

# Ekspor data ad-hoc (analisis loker, rekap posisi). Tidak dipakai aplikasi —
# hanya berkas kerja lokal, dan ukurannya membengkakkan riwayat repo.
*.csv
*.xlsx
